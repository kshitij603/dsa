//Implement Linear Search, Binary Search and Interpolation Search
#include <iostream>
using namespace std;

void linearSearch(int a[], int n, int key)
{
    for (int i = 0; i < n; i++)
    {
        if (a[i] == key)
        {
            cout << "Element found at position " << i + 1 << endl;
            return;
        }
    }

    cout << "Element not found\n";
}

void binarySearch(int a[], int n, int key)
{
    int low = 0;
    int high = n - 1;

    while (low <= high)
    {
        int mid = (low + high) / 2;

        if (a[mid] == key)
        {
            cout << "Element found at position " << mid + 1 << endl;
            return;
        }
        else if (a[mid] < key)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    cout << "Element not found\n";
}

void interpolationSearch(int a[], int n, int key)
{
    int low = 0;
    int high = n - 1;

    while (low <= high && key >= a[low] && key <= a[high])
    {
        if (a[low] == a[high])
        {
            if (a[low] == key)
            {
                cout << "Element found at position " << low + 1 << endl;
            }
            else
            {
                cout << "Element not found\n";
            }

            return;
        }

        int pos = low + ((key - a[low]) * (high - low))
                       / (a[high] - a[low]);

        if (a[pos] == key)
        {
            cout << "Element found at position " << pos + 1 << endl;
            return;
        }
        else if (a[pos] < key)
        {
            low = pos + 1;
        }
        else
        {
            high = pos - 1;
        }
    }

    cout << "Element not found\n";
}

