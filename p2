//Implement Infix to Postfix Expression Conversion using Stack
#include <iostream>
#include <cstring>
using namespace std;

#define MAX 100

char stack[MAX];
int top = -1;

void push(char ch)
{
    if (top == MAX - 1)
    {
        cout << "Stack Overflow\n";
    }
    else
    {
        top++;
        stack[top] = ch;
    }
}

char pop()
{
    if (top == -1)
    {
        return '\0';
    }
    else
    {
        char ch = stack[top];
        top--;
        return ch;
    }
}

char peek()
{
    if (top == -1)
    {
        return '\0';
    }
    return stack[top];
}

int priority(char ch)
{
    if (ch == '^')
        return 3;
    else if (ch == '*' || ch == '/' || ch == '%')
        return 2;
    else if (ch == '+' || ch == '-')
        return 1;
    else
        return 0;
}

bool isOperator(char ch)
{
    if (ch == '+' || ch == '-' || ch == '*' ||
        ch == '/' || ch == '%' || ch == '^')
        return true;

    return false;
}

void infixToPostfix(char infix[])
{
    char postfix[MAX];
    int j = 0;

    for (int i = 0; infix[i] != '\0'; i++)
    {
        char ch = infix[i];

        // If operand, add directly to postfix
        if ((ch >= 'A' && ch <= 'Z') ||
            (ch >= 'a' && ch <= 'z') ||
            (ch >= '0' && ch <= '9'))
        {
            postfix[j] = ch;
            j++;
        }

        // If opening bracket
        else if (ch == '(')
        {
            push(ch);
        }

        // If closing bracket
        else if (ch == ')')
        {
            while (top != -1 && peek() != '(')
            {
                postfix[j] = pop();
                j++;
            }

            if (top != -1)
                pop();
        }

        // If operator
        else if (isOperator(ch))
        {
            while (top != -1 &&
                   peek() != '(' &&
                   priority(peek()) >= priority(ch))
            {
                postfix[j] = pop();
                j++;
            }

            push(ch);
        }
    }

    // Pop remaining operators
    while (top != -1)
    {
        postfix[j] = pop();
        j++;
    }

    postfix[j] = '\0';

    cout << "Postfix Expression: " << postfix << endl;
}

int main()
{
    char infix[MAX];

    cout << "Enter Infix Expression: ";
    cin >> infix;

    infixToPostfix(infix);

    return 0;
}
